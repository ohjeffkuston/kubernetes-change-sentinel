{
  "before": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "payments-api",
        "namespace": "prod"
      },
      "spec": {
        "replicas": 3,
        "template": {
          "spec": {
            "containers": [
              {
                "name": "api",
                "image": "example/payments-api:1.8.4",
                "resources": {
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "after": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "payments-api",
        "namespace": "prod"
      },
      "spec": {
        "replicas": 1,
        "template": {
          "spec": {
            "containers": [
              {
                "name": "api",
                "image": "example/payments-api:latest",
                "resources": {
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "payments-api",
        "namespace": "prod"
      },
      "spec": {
        "type": "LoadBalancer"
      }
    }
  ]
}

